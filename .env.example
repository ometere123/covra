# COVRA / Phase 2 Bradbury and Base Sepolia.
# Copy to .env.local. Do not commit populated credentials.
# Pages load in explicit READ-ONLY DEMO mode without credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
COVRA_ENV=testnet

# Required for wallet authentication and scoped agent credentials
AUTH_SECRET=
AGENT_API_KEY_PEPPER=

# Supabase project (private claim evidence and user/agent/claim persistence)
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=covra-evidence-private

# Bradbury PHASE 2 (chain 4221); blockchain RPC does not support gen_* methods
BRADBURY_CHAIN_ID=4221
BRADBURY_CHAIN_RPC_URL=https://rpc.testnet-chain.genlayer.com
BRADBURY_NODE_RPC_URL=https://rpc-bradbury.genlayer.com
# Optional PUBLIC, unkeyed gen_* RPC for wallet-based browser writes. Never put
# an API token, password, query credential or privileged endpoint here.
NEXT_PUBLIC_BRADBURY_NODE_RPC_URL=https://rpc-bradbury.genlayer.com
BRADBURY_EXPECTED_GENESIS_HASH=0x17d89764d4f4f963158fc4c5e8f2cb670c2837740b35f37081c12860c3df97e4
BRADBURY_ADDRESS_MANAGER=0x3F71AE080BD6270A91dBcc7960d88797828538E0
BRADBURY_ADJUDICATOR_ADDRESS=
NEXT_PUBLIC_BRADBURY_ADJUDICATOR_ADDRESS=

# Native Circle USDC on BASE SEPOLIA ONLY
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_COVRA_POOLS_ADDRESS=
BASE_DEPLOYMENT_START_BLOCK=

# Server-side quote signing key. Use a disposable dedicated testnet key.
# NEVER place a deployment or quote signer key in NEXT_PUBLIC_ variables.
QUOTE_SIGNER_PRIVATE_KEY=
NEXT_PUBLIC_QUOTE_SIGNER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
# Independent, separately held addresses: never store all five attestor private keys together.
ATTESTOR_ADDRESS_1=
ATTESTOR_ADDRESS_2=
ATTESTOR_ADDRESS_3=
ATTESTOR_ADDRESS_4=
ATTESTOR_ADDRESS_5=
# Comma-separated list of exact, independently approved public evidence issuer
# hostnames. Required by attestor preflight, never a user-provided wildcard.
ATTESTOR_EVIDENCE_HOSTS=
# Independent, operator-reviewed hostname -> wallet address JSON. Must match
# approved hosts and signatures. Example: {"issuer.example.org":"0x..."}
ATTESTOR_ISSUER_WALLETS={}
# Required to issue executable quotes; exact-host allowlist, no wildcards.
COVRA_APPROVED_ISSUER_HOSTS=
# Operator-only signing credentials. Do NOT deploy all five in this .env.local.
# Run on a separate secured machine for each independent issuer or attestor.
EVIDENCE_ISSUER_PRIVATE_KEY=
EVIDENCE_ISSUER_HOST=
EVIDENCE_ISSUER_WALLET=
EVIDENCE_ISSUER_ADMIN_TOKEN=
EVIDENCE_ISSUER_TTL_SECONDS=9504000
# ATTESTOR_PRIVATE_KEY=
# Local functional test only; never add these to Vercel, GitHub Actions or a hosted runtime.
# ATTESTOR1_PRIVATE_KEY=
# ATTESTOR2_PRIVATE_KEY=
# ATTESTOR3_PRIVATE_KEY=
# ATTESTOR4_PRIVATE_KEY=
# ATTESTOR5_PRIVATE_KEY=
# ATTESTOR_MANUAL_APPROVAL=I_INDEPENDENTLY_VERIFIED_THIS_CASE
COVRA_DEPLOY_CONFIRM=

# Only if self-hosting a signed event ingestion endpoint
INDEXER_CRON_SECRET=

# Optional (email, monitoring, provider evidence feeds)
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
MONITORING_PROVIDER_API_KEY=
CHAIN_INDEXER_API_KEY=

# The 5 attestors are configured ON-CHAIN, not through a single backend key.
# No real-money payout before independently operated attestations and audits.
